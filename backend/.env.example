PORT=5000

# Local development (Postgres running on this machine):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bloodconnect"

# Production (Neon) — copy the connection string from your Neon project dashboard:
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Secret key used to sign JWTs. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER commit the real value or reuse this example value in production.
JWT_SECRET="replace-with-a-long-random-string"
